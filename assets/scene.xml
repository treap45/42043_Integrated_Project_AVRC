<!--
  Task scene: UR3e + Robotiq 2F-85 + wrist-mounted RealSense D435 on a table, with a red cube,
  a magenta place zone, up to three occluder boxes and a camera calibration checkerboard (parked by default).

  Sources:
    - third_party/universal_robots_ur3e/ur3e.xml (BSD-3-Clause, github.com/SouthColumn76/universal_robots_ur3e,
      the model used in the course tutorial github.com/rFalque/mujoco_UR3_tutorial)
      arm body tree copied below, actuators changed
    - third_party/mujoco_menagerie/robotiq_2f85/2f85.xml (BSD-2-Clause)  attached unchanged at the flange
    - third_party/mujoco_menagerie/realsense_d435i/d435i.xml (Apache-2.0)  visual model attached on the wrist

  Changes w.r.t. the UR3e model:
    - Arm actuators are torque motors (ctrl = joint torque in N m) instead of position servos.
      Limits follow the UR3e spec: 56 N m for base and shoulder, 28 N m for the elbow, 12 N m for the wrists.
    - The arm base sits on the table top.

  Conventions:
    - World frame: z up, origin on the floor under the robot base. The table top is at z = 0.75.
    - The robot faces +x; the workspace is the table area in front of it.
    - Camera "wrist_cam" follows the MuJoCo convention: it looks along its local -z with +y up.
      OpenCV uses +z forward, +y down, i.e. R_cv_from_mj = diag(1, -1, -1).
    - Objects to randomise per trial (positions, sizes, visibility) are mocap bodies or have a free
      joint; see the comments next to each one.
-->
<mujoco model="avrc_task">
  <compiler angle="radian" autolimits="true" meshdir="../third_party/universal_robots_ur3e/assets"/>

  <option integrator="implicitfast" timestep="0.002" cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.3 0.3 0.3" ambient="0.15 0.15 0.15" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-25" offwidth="1280" offheight="720"/>
    <map znear="0.01"/>
  </visual>

  <statistic center="0.3 0 0.85" extent="0.9"/>

  <default>
    <default class="ur3e">
      <material specular="0.5" shininess="0.25"/>
      <joint axis="0 1 0" range="-6.28319 6.28319" armature="0.1"/>
      <motor ctrlrange="-12 12"/>
      <default class="size2">
        <motor ctrlrange="-56 56"/>
      </default>
      <default class="size1">
        <default class="size1_limited">
          <joint range="-3.14159 3.14159"/>
          <motor ctrlrange="-28 28"/>
        </default>
      </default>
      <default class="size0">
        <motor ctrlrange="-12 12"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="capsule" group="3"/>
        <default class="eef_collision">
          <geom type="cylinder"/>
        </default>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>

    <default class="occluder">
      <geom type="box" rgba="0.55 0.6 0.65 1" friction="0.8"/>
    </default>
  </default>

  <asset>
    <model name="gripper" file="../third_party/mujoco_menagerie/robotiq_2f85/2f85.xml"/>
    <model name="d435" file="../third_party/mujoco_menagerie/realsense_d435i/d435i.xml"/>

    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <texture type="2d" name="calib_board" file="calib_board.png"/>
    <material name="calib_board" texture="calib_board"/>
    <material name="table_top" rgba="0.62 0.58 0.52 1"/>
    <material name="table_leg" rgba="0.35 0.35 0.35 1"/>

    <material class="ur3e" name="black" rgba="0.033 0.033 0.033 1"/>
    <material class="ur3e" name="jointgray" rgba="0.278 0.278 0.278 1"/>
    <material class="ur3e" name="linkgray" rgba="0.82 0.82 0.82 1"/>
    <material class="ur3e" name="urblue" rgba="0.49 0.678 0.8 1"/>

    <mesh file="base_0.obj"/>
    <mesh file="base_1.obj"/>
    <mesh file="shoulder_0.obj"/>
    <mesh file="shoulder_1.obj"/>
    <mesh file="shoulder_2.obj"/>
    <mesh file="upperarm_0.obj"/>
    <mesh file="upperarm_1.obj"/>
    <mesh file="upperarm_2.obj"/>
    <mesh file="upperarm_3.obj"/>
    <mesh file="forearm_0.obj"/>
    <mesh file="forearm_1.obj"/>
    <mesh file="forearm_2.obj"/>
    <mesh file="forearm_3.obj"/>
    <mesh file="wrist1_0.obj"/>
    <mesh file="wrist1_1.obj"/>
    <mesh file="wrist1_2.obj"/>
    <mesh file="wrist2_0.obj"/>
    <mesh file="wrist2_1.obj"/>
    <mesh file="wrist2_2.obj"/>
    <mesh file="wrist3.obj"/>
  </asset>

  <worldbody>
    <light pos="0.3 0 2.5" dir="0.2 0.1 -1" directional="true" diffuse="0.5 0.5 0.5" specular="0.1 0.1 0.1"
           castshadow="false"/>
    <light name="spotlight" mode="targetbodycom" target="wrist_2_link" pos="0.3 -1 2.2" diffuse="0.3 0.3 0.3"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Table: top surface at z = 0.75 m, spans x in [-0.2, 0.7], y in [-0.5, 0.5]. -->
    <body name="table" pos="0.25 0 0">
      <geom name="table_top" type="box" pos="0 0 0.73" size="0.45 0.5 0.02" material="table_top" friction="0.8"/>
      <geom type="box" pos="0.4 0.45 0.355" size="0.03 0.03 0.355" material="table_leg"/>
      <geom type="box" pos="0.4 -0.45 0.355" size="0.03 0.03 0.355" material="table_leg"/>
      <geom type="box" pos="-0.4 0.45 0.355" size="0.03 0.03 0.355" material="table_leg"/>
      <geom type="box" pos="-0.4 -0.45 0.355" size="0.03 0.03 0.355" material="table_leg"/>
    </body>

    <!-- UR3e (body tree from ur3e.xml, unchanged except the base position). -->
    <body name="base" pos="0 0 0.75" childclass="ur3e">
      <inertial mass="2" pos="0 0 0" diaginertia="0.0030532 0.0030532 0.005625"/>
      <geom mesh="base_0" material="jointgray" class="visual"/>
      <geom mesh="base_1" material="black" class="visual"/>
      <body name="shoulder_link" pos="0 0 0.152">
        <inertial mass="2" pos="0 0 0" diaginertia="0.00809316 0.00809316 0.005625"/>
        <joint name="shoulder_pan_joint" class="size2" axis="0 0 1"/>
        <geom mesh="shoulder_0" material="urblue" class="visual"/>
        <geom mesh="shoulder_1" material="black" class="visual"/>
        <geom mesh="shoulder_2" material="jointgray" class="visual"/>
        <geom class="collision" size="0.047 0.05" pos="0 0 -0.032"/>
        <body name="upper_arm_link" pos="0 0.12 0" quat="1 0 1 0">
          <inertial mass="3.42" pos="0 0 0.122" diaginertia="0.0217285 0.0217285 0.00961875"/>
          <joint name="shoulder_lift_joint" class="size2"/>
          <geom mesh="upperarm_0" material="black" class="visual"/>
          <geom mesh="upperarm_1" material="urblue" class="visual"/>
          <geom mesh="upperarm_2" material="jointgray" class="visual"/>
          <geom mesh="upperarm_3" material="linkgray" class="visual"/>
          <geom class="collision" size="0.046 0.06" pos="0 -0.04 0" quat="1 1 0 0"/>
          <geom class="collision" size="0.038 0.11" pos="0 0 0.12"/>
          <body name="forearm_link" pos="0 -0.093 0.244">
            <inertial mass="1.26" pos="0 0 0.10625" diaginertia="0.00654457 0.00654457 0.00354375"/>
            <joint name="elbow_joint" class="size1_limited"/>
            <geom mesh="forearm_0" material="urblue" class="visual"/>
            <geom mesh="forearm_1" material="linkgray" class="visual"/>
            <geom mesh="forearm_2" material="black" class="visual"/>
            <geom mesh="forearm_3" material="jointgray" class="visual"/>
            <geom class="collision" size="0.038 0.048" pos="0 0.062 0" quat="1 1 0 0"/>
            <geom class="collision" size="0.032 0.103" pos="0 0 0.11"/>
            <body name="wrist_1_link" pos="0.0005 0 0.2125" quat="1 0 1 0">
              <inertial mass="0.8" pos="0 0.104 0" diaginertia="0.00225 0.002085 0.002085"/>
              <joint name="wrist_1_joint" class="size0"/>
              <geom mesh="wrist1_0" material="jointgray" class="visual"/>
              <geom mesh="wrist1_1" material="urblue" class="visual"/>
              <geom mesh="wrist1_2" material="black" class="visual"/>
              <geom class="collision" size="0.032 0.05" pos="0 0.045 0" quat="1 1 0 0"/>
              <body name="wrist_2_link" pos="0 0.104 0">
                <inertial mass="0.8" pos="0 0 0.085" diaginertia="0.00225 0.002085 0.002085"/>
                <joint name="wrist_2_joint" axis="0 0 1"/>
                <geom mesh="wrist2_0" material="jointgray" class="visual"/>
                <geom mesh="wrist2_1" material="black" class="visual"/>
                <geom mesh="wrist2_2" material="urblue" class="visual"/>
                <geom class="collision" size="0.032 0.05" pos="0 0 0.035"/>
                <geom class="collision" size="0.032 0.027" pos="0 0.01 0.085" quat="1 1 0 0"/>
                <body name="wrist_3_link" pos="0 0 0.085">
                  <inertial mass="0.35" pos="0 0.0715 0" quat="1 0 0 1"
                            diaginertia="0.0001792 0.000136267 0.000136267"/>
                  <joint name="wrist_3_joint"/>
                  <geom mesh="wrist3" material="linkgray" class="visual"/>
                  <geom class="eef_collision" size="0.032 0.023" pos="0 0.07 0" quat="1 1 0 0"/>
                  <site name="attachment_site" pos="0 0.09215 0" quat="-1 1 0 0"/>

                  <!-- Flange frame (same pose as attachment_site): +z points out of the tool. -->
                  <body name="flange" pos="0 0.09215 0" quat="-1 1 0 0">
                    <attach model="gripper" body="base_mount" prefix="gripper_"/>
                    <!-- Tool centre point between the finger pads when closed. -->
                    <site name="tcp" pos="0 0 0.156" size="0.004" rgba="0 1 0 1" group="4"/>

                    <!-- Camera bracket (visual only). -->
                    <geom name="camera_bracket" type="box" pos="0 -0.062 0.022" size="0.018 0.026 0.003"
                          rgba="0.15 0.15 0.15 1" contype="0" conaffinity="0" group="2" mass="0.05"/>
                    <!-- D435 on the side of the flange, offset along flange -y (perpendicular to the
                         finger plane) and pitched 15 deg so the optical axis meets the tool axis
                         about 0.3 m in front of the flange. -->
                    <body name="camera_mount" pos="0 -0.085 0.035" euler="2.88 0 0">
                      <body name="d435_body" pos="-0.0325 0 -0.0036" euler="3.14159 0 0">
                        <attach model="d435" body="d435i" prefix="d435_"/>
                      </body>
                      <!-- Colour optical centre; aligned depth shares this camera. 640x480 colour stream:
                           ~55 x 42 deg FOV. -->
                      <camera name="wrist_cam" pos="0 0 0" fovy="42" resolution="640 480"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Red cube, 5 cm. Randomise x, y and yaw through its free joint (qpos). -->
    <body name="cube" pos="0.35 0 0.775">
      <freejoint name="cube_joint"/>
      <geom name="cube" type="box" size="0.025 0.025 0.025" rgba="0.85 0.05 0.05 1" mass="0.1" friction="1.0"
            condim="4"/>
    </body>

    <!-- Magenta place zone, 10 cm square, visual only. Randomise through data.mocap_pos. -->
    <body name="place_zone" mocap="true" pos="0.3 0.25 0.7505">
      <geom name="place_zone" type="box" size="0.05 0.05 0.0005" rgba="0.9 0.1 0.9 1"
            contype="0" conaffinity="0"/>
    </body>

    <!-- Occluders: up to three boxes. Randomise pose through data.mocap_pos / mocap_quat and
         height through model.geom_size (also update model.geom_rbound). Park unused ones off the table,
         e.g. at z = -1. Default sizes here are 4 x 4 x 12 cm. -->
    <body name="occluder_0" mocap="true" pos="0 0.9 -1">
      <geom name="occluder_0" class="occluder" size="0.02 0.02 0.06"/>
    </body>
    <body name="occluder_1" mocap="true" pos="0.2 0.9 -1">
      <geom name="occluder_1" class="occluder" size="0.02 0.02 0.06"/>
    </body>
    <body name="occluder_2" mocap="true" pos="0.4 0.9 -1">
      <geom name="occluder_2" class="occluder" size="0.02 0.02 0.06"/>
    </body>

    <!-- Camera calibration checkerboard: 10 x 7 squares of 20 mm with a one-square white margin, 3 mm thick,
         visual only. Texture from scripts/make_calib_board.py (columns along the board x axis). Parked under
         the floor; TaskSim.place_calib_board() moves it through data.mocap_pos / mocap_quat. -->
    <body name="calib_board" mocap="true" pos="0.6 0.9 -1">
      <geom name="calib_board" type="box" size="0.12 0.09 0.0015" material="calib_board"
            contype="0" conaffinity="0"/>
    </body>

    <!-- Fixed overview camera for videos. -->
    <camera name="overview" pos="1.3 -1.0 1.45" xyaxes="0.6 0.8 0 -0.35 0.26 0.9"/>

    <!-- Fixed RGB-D camera standing in for the lab's eye-to-hand D435i, for testing src/real/ in simulation
         (scripts/run_real.py --sim). Not used by the simulation pipeline. About 0.89 m from the workspace
         centre (0.32, -0.05) at 38 deg below horizontal; fovy 43 matches the D435i RGB fy of about 610 px. -->
    <camera name="fixed_cam" pos="0.85 -0.50 1.30" xyaxes="0.6472 0.7623 0 -0.4729 0.4015 0.7843" fovy="43"
            resolution="640 480"/>
  </worldbody>

  <!-- "observe": wrist camera 0.42 m above the table at (0.30, 0), looking down at (0.33, 0) with image up = +x.
       qpos = 6 arm joints, 8 gripper joints, cube free joint (x y z qw qx qy qz). -->
  <keyframe>
    <key name="observe"
         qpos="-0.8264 -2.1217 1.4425 -1.1217 -1.3281 -0.7982
               0 0 0 0 0 0 0 0
               0.35 0 0.775 1 0 0 0"
         mpos="0.3 0.25 0.7505  0 0.9 -1  0.2 0.9 -1  0.4 0.9 -1  0.6 0.9 -1"/>
  </keyframe>

  <actuator>
    <motor class="size2" name="shoulder_pan" joint="shoulder_pan_joint"/>
    <motor class="size2" name="shoulder_lift" joint="shoulder_lift_joint"/>
    <motor class="size1_limited" name="elbow" joint="elbow_joint"/>
    <motor class="size0" name="wrist_1" joint="wrist_1_joint"/>
    <motor class="size0" name="wrist_2" joint="wrist_2_joint"/>
    <motor class="size0" name="wrist_3" joint="wrist_3_joint"/>
  </actuator>
</mujoco>
